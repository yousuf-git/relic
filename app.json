{
  "expo": {
    "name": "Relic",
    "slug": "relic",
    "scheme": "relic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0B09",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.yousuf.relic"
    },
    "android": {
      "package": "app.yousuf.relic",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D0B09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0B09",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Relic uses the microphone to record voice relics."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Relic lets you add photos to your memories.",
          "cameraPermission": "Relic lets you take photos for your memories."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Relic can tag where a memory happened."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Relic can lock your vault with Face ID."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Relic uses the microphone so you can speak your memories.",
          "speechRecognitionPermission": "Relic turns your speech into text for quick entries."
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F2A54A"
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/im-fell-dw-pica/400Regular/IMFellDWPica_400Regular.ttf",
            "./node_modules/@expo-google-fonts/newsreader/400Regular/Newsreader_400Regular.ttf",
            "./node_modules/@expo-google-fonts/ibm-plex-mono/500Medium/IBMPlexMono_500Medium.ttf"
          ],
          "widgets": [
            {
              "name": "RelicOfTheDay",
              "label": "Relic of the day",
              "description": "The relic that surfaced from your Vault today.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/art/vessel-letter.webp",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "OnThisDay",
              "label": "On this day",
              "description": "What you kept on this day in years past.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/art/vessel-plate.webp",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "QuickCapture",
              "label": "Quick capture",
              "description": "Preserve a relic with words, voice or a photo.",
              "minWidth": "250dp",
              "minHeight": "72dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "previewImage": "./assets/art/wax-seal.webp"
            },
            {
              "name": "VaultStats",
              "label": "Vault flame",
              "description": "Your flame, your relics, and the duck.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/art/duck-hero.webp",
              "updatePeriodMillis": 3600000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
